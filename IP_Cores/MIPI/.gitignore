# ============================================================================
# HERCOSSNUX Core 18 — MIPI CSI-2 RX — .gitignore
# Keep source (RTL, firmware, verif, scripts, docs). Exclude all build output.
# ============================================================================

# ---- GHDL simulation artifacts ----
verif/work/
verif/__pycache__/
**/*.cf
**/*.o
**/*.ghw
**/*.vcd
verif/*.exe

# generated test vectors (regenerated by gen_vectors.py from the oracle)
verif/*.hex
verif/*.txt
!verif/ecc_vec.txt.keep

# ---- firmware build output (regenerated by build_fw_rv32.sh) ----
fw/*.elf
fw/*.o
fw/fw_rv32.bin
fw/fw_rv32.mem
fw/fw_rv32.ld
fw/crt0.S
fw/fw_model
fw/__pycache__/

# ---- Vivado project & runs (all regenerated from scripts/) ----
vivado/
*.xpr
*.jou
*.log
*.str
.Xil/
*.cache/
*.hw/
*.ip_user_files/
*.runs/
*.gen/
*.sim/
*.srcs/
vivado.log
vivado.jou
*_bd_reference.tcl

# ---- Vivado outputs ----
*.dcp
*.bit
*.pdi
*.ltx
*.rpt

# ---- XSA / hardware handoff ----
petalinux/*.xsa
petalinux/mipi_plnx/

# ---- PetaLinux build (huge; never commit) ----
plnx*/build/
plnx*/images/
plnx*/components/
plnx*/.petalinux/
*.cpio
*.cpio.gz
BOOT.BIN
image.ub

# ---- editor / OS noise ----
*~
*.swp
.DS_Store
