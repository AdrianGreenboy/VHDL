# ============================================================================
# HERCOSSNUX Core 19 — PCS 64B/66B @ 25G — .gitignore
# Keep source (RTL, firmware, verif, oracles, scripts, reports, docs).
# Exclude all build output.
# ============================================================================

# ---- GHDL simulation artifacts ----
**/*.cf
**/*.o
**/*.ghw
**/*.vcd
**/__pycache__/
verif/work/
verif/*.exe

# ---- generated testbench (regenerated by oracle/gen_tb_prbs.py) ----
rtl/tb_pcs_prbs31.vhd

# ---- firmware build output (regenerated by build_fw_rv32.sh) ----
fw/*.elf
fw/*.o
fw/fw_rv32.ld
fw/crt0.S
# NOTE: fw_rv32.bin IS tracked on purpose — the PetaLinux recipe consumes it.
fw/fw_rv32.mem
fw/fw_rv32_sim.bin
fw/fw_rv32_sim.mem

# ---- Vivado project & runs (regenerated from vivado/*.tcl and *.sh) ----
vivado/pcs_soc/
*.xpr
*.jou
*.log
*.str
.Xil/
*.cache/
*.hw/
*.ip_user_files/
*.runs/
*.gen/
*.sim/
*.srcs/
vivado.log
vivado.jou

# ---- Vivado binary outputs ----
*.dcp
*.bit
*.pdi
*.ltx
vivado/gen_files/
vivado/*.bif
vivado/*.rcdo
vivado/*.rnpi

# Keep the scripts, constraints and reports that document the flow:
#   vivado/gen_pcs_bd_tcl.sh, vivado/pcs_soc_bd.tcl, vivado/mipi_soc_bd_base.tcl,
#   vivado/pcs_25g_cdc.xdc, vivado/timing_*.txt, vivado/cdc_*.txt

# ---- XSA / hardware handoff (4.6 MB, regenerated by write_hw_platform) ----
petalinux/*.xsa

# ---- PetaLinux build (huge; never commit) ----
plnx*/build/
plnx*/images/
plnx*/components/
*.cpio
*.cpio.gz
BOOT.BIN
image.ub

# ---- editor / OS noise ----
*~
*.swp
.DS_Store

# ---- Vivado tool artifacts (not ours) ----
vivado/static_files/
vivado/wdi_info.xml

# ---- intermediate timing/CDC reports (debug history) ----
vivado/timing_synth.txt
vivado/timing_synth2.txt
vivado/timing_synth3.txt
vivado/timing_impl.txt
vivado/timing_impl2.txt
vivado/timing_impl3.txt
vivado/timing_aggr.txt
vivado/timing_postroute.txt
vivado/timing_final.txt
vivado/timing_hold.txt
vivado/cdc_report.txt
vivado/cdc_report2.txt
vivado/cdc_critical.txt
vivado/cdc_det.txt
vivado/cdc_final.txt
