  <MODULES>
    <MODULE HWVERSION="1.0" INSTANCE="psv_acpu_gic" IPTYPE="INTERRUPT_CNTLR" IS_ENABLE="1" IS_PL="FALSE" MODCLASS="INTERRUPT_CNTLR" MODTYPE="psv_acpu_gic">
      <PARAMETERS>
        <PARAMETER NAME="APU_GIC_ITS_CTL" VALUE="0xF9020000"/>
        <PARAMETER NAME="C_S_AXI_BASEADDR" VALUE="0xF9000000"/>
        <PARAMETER NAME="C_S_AXI_HIGHADDR" VALUE="0xF907FFFF"/>
      </PARAMETERS>
      <PORTS>
        <PORT DIR="O" NAME="IRQ_A72_0" SIGIS="INTERRUPT" SIGNAME="psv_acpu_gic_IRQ_A72_0">
          <CONNECTIONS>
            <CONNECTION INSTANCE="psv_cortexa72_0" PORT="IRQ_A72_0"/>
          </CONNECTIONS>
        </PORT>
        <PORT DIR="O" NAME="IRQ_A72_1" SIGIS="INTERRUPT" SIGNAME="psv_acpu_gic_IRQ_A72_1">
          <CONNECTIONS>
            <CONNECTION INSTANCE="psv_cortexa72_1" PORT="IRQ_A72_1"/>
          </CONNECTIONS>
        </PORT>
        <PORT DIR="I" IRQID="5" NAME="IRQ_ADMA0" SIGIS="INTERRUPT" SIGNAME="psv_acpu_gic_IRQ_ADMA0">
          <CONNECTIONS>
            <CONNECTION INSTANCE="psv_adma_0" PORT="IRQ_ADMA0"/>
          </CONNECTIONS>
        </PORT>
        <PORT DIR="I" IRQID="6" NAME="IRQ_ADMA1" SIGIS="INTERRUPT" SIGNAME="psv_acpu_gic_IRQ_ADMA1">
          <CONNECTIONS>
            <CONNECTION INSTANCE="psv_adma_1" PORT="IRQ_ADMA1"/>
          </CONNECTIONS>
        </PORT>
        <PORT DIR="I" IRQID="7" NAME="IRQ_ADMA2" SIGIS="INTERRUPT" SIGNAME="psv_acpu_gic_IRQ_ADMA2">
          <CONNECTIONS>
            <CONNECTION INSTANCE="psv_adma_2" PORT="IRQ_ADMA2"/>
