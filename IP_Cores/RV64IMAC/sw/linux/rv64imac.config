# Fragmento sobre tinyconfig para el SoC RV64IMAC (SPEC_FREEZE_V1 + Zicbom)
CONFIG_64BIT=y
CONFIG_MMU=y
CONFIG_ARCH_RV64I=y
CONFIG_CMODEL_MEDANY=y
# CONFIG_SMP is not set
# CONFIG_FPU is not set
CONFIG_RISCV_ISA_C=y
CONFIG_RISCV_ISA_ZICBOM=y
# CONFIG_RISCV_ISA_ZICBOZ is not set
# CONFIG_RISCV_ISA_SVPBMT is not set
# CONFIG_RISCV_ISA_V is not set
# CONFIG_ERRATA_SIFIVE is not set
# CONFIG_ERRATA_THEAD is not set
CONFIG_RISCV_SBI_V01=y
CONFIG_NONPORTABLE=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_EARLY_PRINTK=y
CONFIG_TTY=y
CONFIG_HVC_RISCV_SBI=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
CONFIG_SIFIVE_PLIC=y
CONFIG_BINFMT_ELF=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="initramfs.list"
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# CONFIG_KALLSYMS is not set
CONFIG_CMDLINE="earlycon=sbi console=hvc0"
CONFIG_CMDLINE_FALLBACK=y
